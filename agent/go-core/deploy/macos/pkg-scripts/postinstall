#!/usr/bin/env bash
set -euo pipefail

APP_SUPPORT_DIR="/Library/Application Support/HostLens"
LOG_DIR="/Library/Logs/HostLens"
CONFIG_PATH="$APP_SUPPORT_DIR/config.json"
TEMPLATE_PATH="$APP_SUPPORT_DIR/config.template.json"

mkdir -p "$APP_SUPPORT_DIR" "$LOG_DIR"
chmod 755 "$APP_SUPPORT_DIR" "$LOG_DIR"
chown root:wheel "$APP_SUPPORT_DIR" "$LOG_DIR"

if [[ ! -f "$CONFIG_PATH" && -f "$TEMPLATE_PATH" ]]; then
  chmod 600 "$TEMPLATE_PATH"
  chown root:wheel "$TEMPLATE_PATH"
fi

if [[ -f /usr/local/bin/hostlensctl && -f "$CONFIG_PATH" ]]; then
  /usr/local/bin/hostlensctl start >/dev/null 2>&1 || true
fi
